# Set these on the web service. Use the deployed HTTPS origin, with no path.
PUBLIC_ORIGIN=http://localhost:3000
# Optional for the website to start; required to create the first owner login.
OWNER_SIGNUP_TOKEN=
WORKER_TOKEN=
PORTAL_DATA_DIR=./data/portal

# On Railway, the website starts the worker by default. Use 1 to enable locally
# or 0 to keep the worker separate. Combined sessions default to PORTAL_DATA_DIR/worker.
# PORTAL_RUN_WORKER=1
# WORKER_DATA_DIR=./data/portal/worker
GEMINI_API_KEY=

# Set only for a separate worker. Its WORKER_TOKEN must match the website.
# PORTAL_INTERNAL_URL=http://localhost:3000
