# Set these on the web service. Use the deployed HTTPS origin, with no path.
PUBLIC_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORKER_TOKEN=
PORTAL_DATA_DIR=./data/portal

# Set these on the worker service. WORKER_TOKEN must match the web service.
# POINT at the web service's private Railway address in production.
PORTAL_INTERNAL_URL=http://localhost:3000
WORKER_DATA_DIR=./data/worker
GEMINI_API_KEY=
